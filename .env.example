# ---- LLM provider used by the MCP server (keyword extraction only) ----
LLM_PROVIDER=openrouter
LLM_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# ---- Qdrant (started by docker-compose; change if you run your own) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Optional: let an LLM extract extra entities per section at startup (slow, costs API calls)
USE_LLM_EXTRACT=false

# Optional: Ollama instead of OpenRouter
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b

# ---- Agent side (labs/lab7, labs/lab8) ----
OPENROUTER_MODEL=qwen/qwen3.5-35b-a3b
MCP_SERVER_URL=http://127.0.0.1:8100/mcp
